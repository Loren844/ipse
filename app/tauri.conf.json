{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ipse",
  "version": "0.2.0",
  "identifier": "io.github.loren844.ipse",
  "build": {
    "frontendDist": "welcome"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Ipse",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 380,
        "minHeight": 500,
        "zoomHotkeysEnabled": true,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
